        <span style="font-size: 0.8rem; background: #e2ebe1; padding: 4px 12px; border-radius: 40px;">Offline</span>
      </div>
      <div class="step-card">
        <div class="step-number">3</div>
        <h3>Sync &amp; Manage</h3>
