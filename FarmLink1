<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Farm Link – Offline-First Coffee Supply Chain OS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />
  <style>
    /* ── Reset & Base ── */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #ffffff;
      color: #1a2c1e;
      line-height: 1.6;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ── Typography ── */
    h1 {
      font-size: 3.2rem;
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.02em;
      margin-bottom: 1.2rem;
    }

    h2 {
      font-size: 2.4rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #1e3a2f;
      margin-bottom: 1rem;
    }

    h3 {
      font-size: 1.5rem;
      font-weight: 700;
      color: #1e3a2f;
      margin-bottom: 0.6rem;
    }

    .section {
      padding: 80px 0;
    }

    .section-subtitle {
      font-size: 1.2rem;
      color: #3d5a44;
      max-width: 700px;
      margin: 0 auto 2rem auto;
      text-align: center;
    }

    /* ── Buttons ── */
    .btn {
      display: inline-block;
      padding: 14px 34px;
      border-radius: 40px;
      font-weight: 600;
      font-size: 1rem;
      text-decoration: none;
      transition: all 0.25s ease;
      border: none;
      cursor: pointer;
    }

    .btn-primary {
      background: #e67e22;
      color: #fff;
      box-shadow: 0 4px 14px rgba(230, 126, 34, 0.25);
    }
    .btn-primary:hover {
      background: #cf711f;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(230, 126, 34, 0.30);
    }

    .btn-outline {
      background: transparent;
      color: #1e3a2f;
      border: 1.5px solid #1e3a2f;
    }
    .btn-outline:hover {
      background: #1e3a2f;
      color: #fff;
    }

    .btn-white {
      background: #fff;
      color: #1e3a2f;
    }
    .btn-white:hover {
      background: #eef4ed;
      transform: translateY(-2px);
    }

    /* ── Header / Navbar ── */
    .site-header {
      padding: 16px 0;
      border-bottom: 1px solid #eef2ee;
      position: sticky;
      top: 0;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(10px);
      z-index: 100;
    }

    .header-flex {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
    }

    .logo {
      font-size: 1.8rem;
      font-weight: 800;
      color: #1e3a2f;
      letter-spacing: -0.02em;
    }
    .logo span {
      color: #e67e22;
    }

    .nav-links {
      display: flex;
      gap: 28px;
      align-items: center;
      flex-wrap: wrap;
    }
    .nav-links a {
      text-decoration: none;
      color: #2c4b32;
      font-weight: 500;
      font-size: 0.95rem;
      transition: color 0.2s;
    }
    .nav-links a:hover {
      color: #e67e22;
    }
    .nav-links .btn {
      padding: 8px 24px;
    }

    /* ── Banner Slider ── */
    .banner-slider {
      background: #f5f8f4;
      padding: 60px 0 80px;
    }

    .banner-slide {
      display: flex;
      align-items: center;
      gap: 48px;
      flex-wrap: wrap;
    }

    .banner-content {
      flex: 1;
      min-width: 280px;
    }

    .banner-content h1 {
      background: linear-gradient(135deg, #1e3a2f 0%, #2b6e3c 80%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .banner-content p {
      font-size: 1.2rem;
      color: #2d4a33;
      margin-bottom: 2rem;
    }

    .banner-visual {
      flex: 1;
      min-width: 280px;
      background: #e7efe6;
      border-radius: 32px;
      padding: 48px 24px;
      text-align: center;
      border: 1px solid #d0dfce;
      box-shadow: 0 16px 30px -8px rgba(0, 0, 0, 0.04);
    }

    .banner-visual .big-icon {
      font-size: 3.6rem;
      margin-bottom: 12px;
    }

    .banner-badges {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      margin-top: 24px;
    }
    .banner-badges span {
      background: #eef4ed;
      padding: 6px 16px;
      border-radius: 40px;
      font-size: 0.85rem;
      font-weight: 500;
      color: #1e3a2f;
    }

    .banner-dots {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-top: 32px;
    }
    .banner-dots span {
      width: 12px;
      height: 12px;
      border-radius: 20px;
      background: #cbdcc9;
      transition: 0.3s;
      cursor: pointer;
    }
    .banner-dots span.active {
      background: #e67e22;
      width: 32px;
    }

    /* ── Trust Bar ── */
    .trust-bar {
      background: #1e3a2f;
      color: #cfe3d4;
      padding: 14px 0;
      text-align: center;
      font-weight: 500;
      letter-spacing: 0.3px;
      display: flex;
      justify-content: center;
      gap: 36px;
      flex-wrap: wrap;
      font-size: 0.9rem;
    }
    .trust-bar span {
      white-space: nowrap;
    }

    /* ── Stats ── */
    .stat-grid {
      display: flex;
      justify-content: space-between;
      gap: 24px;
      margin: 48px 0 0;
      flex-wrap: wrap;
    }
    .stat-card {
      background: #f9fbf8;
      padding: 28px 20px;
      border-radius: 24px;
      flex: 1;
      text-align: center;
      border: 1px solid #e2ebe1;
      min-width: 140px;
    }
    .stat-number {
      font-size: 2.8rem;
      font-weight: 800;
      color: #e67e22;
      line-height: 1.2;
    }

    /* ── Features / Services ── */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 32px;
      margin-top: 48px;
    }
    .feature-card {
      background: #fff;
      padding: 32px 24px;
      border-radius: 28px;
      border: 1px solid #e2ebe1;
      transition: 0.2s;
      text-align: center;
    }
    .feature-card:hover {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
      transform: translateY(-4px);
    }
    .feature-icon {
      font-size: 2.8rem;
      margin-bottom: 16px;
    }

    /* ── Strengths (like Tigma's "Our Key Strengths") ── */
    .strengths-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 28px;
      margin-top: 48px;
    }
    .strength-card {
      background: #f9fbf8;
      padding: 28px 24px;
      border-radius: 28px;
      border: 1px solid #e2ebe1;
      text-align: center;
    }
    .strength-card .icon {
      font-size: 2.4rem;
      margin-bottom: 12px;
    }
    .strength-card h3 {
      font-size: 1.2rem;
    }
    .strength-card p {
      font-size: 0.95rem;
      color: #3d5a44;
    }

    /* ── How It Works (Steps) ── */
    .steps-grid {
      display: flex;
      gap: 32px;
      margin-top: 48px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .step-card {
      flex: 1;
      min-width: 220px;
      text-align: center;
      padding: 24px 16px;
      background: #f9fbf8;
      border-radius: 28px;
      border: 1px solid #e2ebe1;
    }
    .step-number {
      background: #e67e22;
      color: #fff;
      width: 48px;
      height: 48px;
      border-radius: 60px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 1.2rem;
      margin-bottom: 16px;
    }

    /* ── Roles Grid ── */
    .roles-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-top: 40px;
    }
    .role-card {
      background: #f9fbf8;
      padding: 20px;
      border-radius: 20px;
      border: 1px solid #e2ebe1;
    }
    .role-card strong {
      display: block;
      color: #1e3a2f;
      font-size: 1.05rem;
    }
    .role-card .access {
      font-size: 0.85rem;
      color: #e67e22;
      font-weight: 600;
    }

    /* ── Comparison Table ── */
    .table-wrap {
      overflow-x: auto;
      margin-top: 40px;
    }
    .compare-table {
      width: 100%;
      border-collapse: collapse;
      background: #fff;
      border-radius: 24px;
      overflow: hidden;
      border: 1px solid #e2ebe1;
    }
    .compare-table th,
    .compare-table td {
      padding: 16px 20px;
      text-align: left;
      border-bottom: 1px solid #e2ebe1;
    }
    .compare-table th {
      background: #f0f5ef;
      font-weight: 700;
      color: #1e3a2f;
    }
    .compare-table tr:last-child td {
      border-bottom: none;
    }
    .check {
      color: #2b6e3c;
      font-weight: 700;
    }
    .cross {
      color: #b33a3a;
      font-weight: 700;
    }

    /* ── Testimonials ── */
    .testimonial-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 32px;
      margin-top: 48px;
    }
    .testimonial-card {
      background: #f9fbf8;
      padding: 28px;
      border-radius: 28px;
      border: 1px solid #e2ebe1;
      font-style: italic;
    }
    .testimonial-card .attribution {
      font-style: normal;
      font-weight: 600;
      margin-top: 16px;
      color: #1e3a2f;
    }

    /* ── Commercial (high-level) ── */
    .commercial-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 24px;
      margin-top: 40px;
    }
    .commercial-item {
      background: #f9fbf8;
      padding: 24px;
      border-radius: 24px;
      border: 1px solid #e2ebe1;
    }
    .commercial-item strong {
      display: block;
      font-size: 1.1rem;
      color: #1e3a2f;
    }

    /* ── CTA Section ── */
    .cta-section {
      background: #1e3a2f;
      color: #fff;
      text-align: center;
      padding: 80px 0;
    }
    .cta-section h2 {
      color: #fff;
    }
    .cta-section p {
      font-size: 1.2rem;
      max-width: 600px;
      margin: 16px auto 32px;
      color: #cfe3d4;
    }

    /* ── Footer ── */
    .footer {
      background: #0f2819;
      color: #cfe3d4;
      padding: 48px 0 32px;
    }
    .footer a {
      color: #f0bc7a;
      text-decoration: none;
    }
    .footer a:hover {
      text-decoration: underline;
    }
    .footer-grid {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 32px;
    }
    .footer-bottom {
      margin-top: 40px;
      border-top: 1px solid #2c533a;
      padding-top: 24px;
      font-size: 0.85rem;
      text-align: center;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }
    .footer-badges {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
      justify-content: center;
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      h1 {
        font-size: 2.2rem;
      }
      h2 {
        font-size: 1.8rem;
      }
      .section {
        padding: 48px 0;
      }
      .nav-links {
        display: none;
      }
      .banner-slide {
        flex-direction: column;
      }
      .stat-grid {
        flex-direction: column;
      }
      .trust-bar {
        font-size: 0.75rem;
        gap: 16px;
      }
      .footer-grid {
        flex-direction: column;
        text-align: center;
      }
      .footer-bottom {
        flex-direction: column;
        text-align: center;
      }
    }

    @media (max-width: 480px) {
      .container {
        padding: 0 16px;
      }
      .banner-visual {
        padding: 24px 16px;
      }
    }
  </style>
</head>
<body>

<!-- ===== HEADER ===== -->
